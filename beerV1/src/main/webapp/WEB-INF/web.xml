<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <servlet>
        <servlet-name>Ch3 Beer</servlet-name>
        <servlet-class>com.smxweb.web.BeerSelect</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>Ch4 Redirect</servlet-name>
        <servlet-class>com.smxweb.web.TestRedirect</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>BeerParam</servlet-name>
        <servlet-class>com.smxweb.web.TestInitParams</servlet-class>
        <init-param>
            <param-name>adminEmail</param-name>
            <param-value>kergyAnderul@gmail.com</param-value>
        </init-param>
        <init-param>
            <param-name>mainEmail</param-name>
            <param-value>1145718893@qq.com</param-value>
        </init-param>
    </servlet>

    <servlet>
        <servlet-name>ListenerTester</servlet-name>
        <servlet-class>com.smxweb.web.ListenerTester</servlet-class>
    </servlet>
    
    <servlet>
        <servlet-name>SessionAndUrl</servlet-name>
        <servlet-class>com.smxweb.web.SessionAndUrl</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>CookieTest</servlet-name>
        <servlet-class>com.smxweb.web.CookieTest</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>CheckCookie</servlet-name>
        <servlet-class>com.smxweb.web.CheckCookie</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CookieTest</servlet-name>
        <url-pattern>/CookieTest.do</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>CheckCookie</servlet-name>
        <url-pattern>/CheckCookie.do</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>SessionAndUrl</servlet-name>
        <url-pattern>/SessionTest.do</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>ListenerTester</servlet-name>
        <url-pattern>/ListenTest.do</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>Ch3 Beer</servlet-name>
        <url-pattern>/SelectBeer.do</url-pattern>
    </servlet-mapping>

    
    <servlet-mapping>
        <servlet-name>Ch4 Redirect</servlet-name>
        <url-pattern>/Come.here</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>BeerParam</servlet-name>
        <url-pattern>/TestInit.do</url-pattern>
    </servlet-mapping>

    <context-param>
        <param-name>breed</param-name>
        <param-value>Great Dane</param-value>
    </context-param>

    <listener>
        <listener-class>com.smxweb.listener.MyservletContextListener</listener-class>
    </listener>

    <session-config>
        <session-timeout>10</session-timeout>
    </session-config>

    <login-config>
        <auth-method>FORM</auth-method>
        <form-login-config>
            <form-login-page>/loginPage.html</form-login-page>
            <form-error-page>/loginError.html</form-error-page>
        </form-login-config>
    </login-config>


    <security-role>
        <role-name>Admin</role-name>
    </security-role>

    <security-role>
        <role-name>Guest</role-name>
    </security-role>

    <security-role>
        <role-name>Member</role-name>
    </security-role>

    <security-constraint>
        <web-resource-collection>
            <!-- 有限制的资源 -->
            <web-resource-name>limitedResource</web-resource-name>
            <url-pattern>/form.html</url-pattern>

            <http-method>GET</http-method>
            <http-method>POST</http-method>
        </web-resource-collection>
        <!-- 能访问的用户 -->
        <auth-constraint>
            <role-name>Admin</role-name>
            <role-name>Member</role-name>
        </auth-constraint>

        <user-data-constraint>
            <transport-guarantee>NONE</transport-guarantee>
        </user-data-constraint>
    </security-constraint>

</web-app>

